# ============================================
# Digital Frame 后端服务 - 环境变量配置
# ============================================
# 使用方法：复制此文件为 .env，然后修改配置
# cp .env.example .env

# 服务端口
PORT=3000

# 照片目录路径（Docker容器内路径）
# 实际NAS路径在 docker-compose.yml 中通过 volumes 映射
PHOTOS_PATH=/data/photos

# ============================================
# 和风天气 API 配置
# ============================================
# 申请地址：https://dev.qweather.com
# 免费版每天1000次调用，完全够用
QWEATHER_API_KEY=你的API_KEY

# API 专属域名（和风天气给每个用户分配的唯一域名）
# 从和风天气控制台获取，形如 xxxxxx.re.qweatherapi.com
# 如果不设置，默认使用 devapi.qweather.com
QWEATHER_API_HOST=你的专属域名

# 城市ID（默认北京101010100）
# 可在 https://github.com/qwd/LocationList 查找你所在城市
QWEATHER_LOCATION_ID=101010100

# ============================================
# 缓存配置（单位：毫秒）
# ============================================
# 天气缓存时间（默认30分钟）
WEATHER_CACHE_TTL=1800000

# 照片列表缓存时间（默认5分钟）
PHOTOS_CACHE_TTL=300000
